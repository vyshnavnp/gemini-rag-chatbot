# Virtual Environment
.venv/
.env/

# Other common OS and environment files
__pycache__/
*.pyc

# Streamlit secrets file (MUST NOT be committed)
.streamlit/secrets.toml

# ChromaDB vector store
# This is a binary SQLite database rebuilt by updater.py at runtime.
# On EC2 it is mounted from ./oncobot_data/chroma_db via docker-compose volumes.
# Never commit it -- it changes on every query and has no place in source control.
chroma_db/

# Training notebooks & datasets (not needed at runtime)
notebooks/
datasets/
presentation/

# Local test artefacts
index_metadata.json

# test scripts
test_*.py